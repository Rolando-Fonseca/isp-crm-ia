# Copiar a .env y completar. Nunca commitear .env.

# Meta WhatsApp Cloud API (ver ../DOCS/02-whatsapp-cloud-api.md)
# Token y phone number id pueden quedar vacios en local: el servicio registra el
# mensaje en el CRM y solo loguea la respuesta en vez de enviarla.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v22.0

# Definidos por nosotros. El verify token se pega en la configuracion del webhook
# en Meta; el app secret sale de la app en developers.facebook.com.
META_WEBHOOK_VERIFY_TOKEN=cambia-este-token
META_APP_SECRET=cambia-este-secreto

# CRM (crm-web). La clave debe coincidir con INTERNAL_API_KEY en crm-web/.env
CRM_API_URL=http://localhost:3002
CRM_INTERNAL_API_KEY=cambia-esta-clave

# Clasificador de intencion con Claude. Si ANTHROPIC_API_KEY queda vacio, el
# servicio responde con un acuse fijo y no llama a la API.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLASSIFIER_CONFIDENCE_THRESHOLD=0.6
