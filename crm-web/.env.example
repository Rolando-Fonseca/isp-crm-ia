# Copiar a .env y completar con valores reales. Nunca commitear .env.

# Postgres local de desarrollo (puerto 5434 para no chocar con el 5433 de V1 en produccion)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/isp_crm_ia"

# Clave compartida con agent-service para los endpoints /api/whatsapp/*.
# Debe coincidir con CRM_INTERNAL_API_KEY en agent-service/.env
INTERNAL_API_KEY=cambia-esta-clave
